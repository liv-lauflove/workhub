# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# High Concurrency Database Pooler (Issue #70 — Kesiapan 200+ Concurrent Users)
# Gunakan Port 6543 (Transaction Mode / PgBouncer) agar koneksi PostgreSQL tidak overload
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
